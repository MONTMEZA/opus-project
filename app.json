{
  "expo": {
    "name": "Opus",
    "slug": "opus-project",
    "scheme": "com.opusproject.app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.opusproject.app",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:opus-project.com",
        "applinks:www.opus-project.com",
        "webcredentials:opus-project.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr"
        ],
        "NSCameraUsageDescription": "Opus utilise l’appareil photo quand vous prenez une photo ou filmez une vidéo à publier, à joindre ou à mettre sur votre profil.",
        "NSMicrophoneUsageDescription": "Opus utilise le micro pour enregistrer le son des vidéos que vous filmez.",
        "NSPhotoLibraryUsageDescription": "Opus accède à vos photos et à vos vidéos pour que vous choisissiez celles à publier, à joindre ou à mettre sur votre profil.",
        "NSPhotoLibraryAddUsageDescription": "Opus enregistre dans l’app Photos les images que vous choisissez d’y garder."
      }
    },
    "android": {
      "package": "com.opusproject.app",
      "adaptiveIcon": {
        "backgroundColor": "#E85C1F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-video",
      "expo-audio",
      "expo-image",
      "expo-notifications",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "backgroundColor": "#E85C1F"
        }
      ]
    ],
    "owner": "montmeza",
    "extra": {
      "eas": {
        "projectId": "32996432-49f3-477c-ae9c-ae96cf84edd5"
      }
    }
  }
}
