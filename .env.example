# Copiez ce fichier en ".env" puis remplissez les deux valeurs.
# Elles se trouvent dans Supabase : Project Settings > API.
#
# Tant que ce fichier .env n'existe pas, l'application tourne en MODE DÉMO
# (données en mémoire) : pratique pour tester l'interface tout de suite.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...votre_cle_anon...

# ATTENTION : la clé API Anthropic ne se met JAMAIS ici.
# Elle vit uniquement côté serveur, dans les secrets Supabase
# (voir supabase/functions/ai/ et le README).
